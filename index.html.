
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Интерактивная аналитическая панель посещаемости учебной группы">
    <title>Аналитика посещаемости группы</title>

    <!-- Подключение ECharts -->
    <script src="https://cdn.jsdelivr.net/npm/echarts@5/dist/echarts.min.js"></script>

    <style>
        :root {
            --bg: #f5f7fa;
            --surface: #ffffff;
            --text: #202b3c;
            --muted: #8290a3;
            --border: #e9edf2;
            --primary: #526fba;
            --primary-light: #eaf0fc;
            --green: #35a889;
            --orange: #e6a35c;
            --red: #d87979;
            --shadow: 0 4px 20px rgba(35, 52, 75, 0.045);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI",
                Roboto, Arial, sans-serif;
            background: var(--bg);
            color: var(--text);
            min-height: 100vh;
            padding: 36px 24px;
        }

        .dashboard {
            max-width: 1240px;
            margin: 0 auto;
        }

        /* Шапка */

        .header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 20px;
            margin-bottom: 32px;
        }

        .header h1 {
            font-size: 29px;
            font-weight: 700;
            letter-spacing: -0.8px;
            margin-bottom: 9px;
        }

        .header p {
            color: var(--muted);
            font-size: 14px;
        }

        .status {
            display: flex;
            align-items: center;
            gap: 8px;
            background: #eaf5f1;
            color: #348b72;
            padding: 9px 14px;
            border-radius: 30px;
            font-size: 12px;
            font-weight: 600;
            white-space: nowrap;
        }

        .status-dot {
            width: 7px;
            height: 7px;
            background: #35a889;
            border-radius: 50%;
        }

        /* Общие блоки */

        .section-title {
            font-size: 17px;
            font-weight: 650;
            margin-bottom: 17px;
        }

        .metrics {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 18px;
            margin-bottom: 32px;
        }

        .metric-card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 14px;
            padding: 24px;
            box-shadow: var(--shadow);
        }

        .metric-label {
            color: var(--muted);
            font-size: 13px;
            margin-bottom: 15px;
        }

        .metric-value {
            font-size: 35px;
            font-weight: 750;
            letter-spacing: -1px;
            color: var(--text);
        }

        .metric-description {
            margin-top: 9px;
            font-size: 12px;
            color: var(--muted);
        }

        /* Графики */

        .charts {
            display: grid;
            grid-template-columns: 1fr;
            gap: 22px;
        }

        .chart-card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 14px;
            padding: 25px;
            box-shadow: var(--shadow);
            min-width: 0;
        }

        .chart-heading {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 15px;
            margin-bottom: 12px;
        }

        .chart-heading h2 {
            font-size: 16px;
            font-weight: 650;
            margin-bottom: 6px;
        }

        .chart-heading p {
            font-size: 12px;
            color: var(--muted);
        }

        .chart-tag {
            background: var(--primary-light);
            color: var(--primary);
            padding: 7px 11px;
            border-radius: 6px;
            font-size: 11px;
            white-space: nowrap;
        }

        .chart {
            width: 100%;
            height: 340px;
        }

        /* Состояния загрузки и ошибки */

        .message {
            display: none;
            padding: 22px;
            margin-bottom: 25px;
            border-radius: 10px;
            font-size: 14px;
            line-height: 1.6;
        }

        .message.error {
            display: block;
            background: #fff0f0;
            color: #a64444;
            border: 1px solid #f3d6d6;
        }

        .message.loading {
            display: block;
            background: #edf2fa;
            color: #526fba;
            border: 1px solid #dce5f5;
        }

        .message.success {
            display: block;
            background: #eaf5f1;
            color: #348b72;
            border: 1px solid #d5ebe3;
        }

        .retry-button {
            margin-top: 12px;
            display: inline-block;
            border: none;
            border-radius: 7px;
            padding: 9px 15px;
            background: #526fba;
            color: white;
            cursor: pointer;
            font-size: 13px;
        }

        .retry-button:hover {
            background: #405c9f;
        }

        /* Нижняя часть */

        .footer {
            margin-top: 27px;
            padding: 20px 4px;
            border-top: 1px solid var(--border);
            color: var(--muted);
            font-size: 12px;
            line-height: 1.7;
            text-align: center;
        }

        .footer .updated {
            display: block;
            margin-top: 5px;
            font-size: 11px;
            color: #a2adba;
        }

        /* Адаптивность */

        @media (min-width: 1000px) {
            .charts {
                grid-template-columns: 1fr 1fr;
            }

            .chart-card {
                min-width: 0;
            }

            .chart {
                height: 360px;
            }
        }

        @media (max-width: 700px) {
            body {
                padding: 24px 14px;
            }

            .header {
                flex-direction: column;
                margin-bottom: 25px;
            }

            .header h1 {
                font-size: 23px;
            }

            .metrics {
                grid-template-columns: 1fr;
                gap: 12px;
                margin-bottom: 25px;
            }

            .metric-card {
                padding: 19px;
            }

            .metric-value {
                font-size: 30px;
            }

            .chart-card {
                padding: 17px 12px;
            }

            .chart-heading {
                flex-direction: column;
            }

            .chart {
                height: 300px;
            }

            .chart-tag {
                align-self: flex-start;
            }
        }

        @media (max-width: 380px) {
            .chart {
                height: 270px;
            }

            .header h1 {
                font-size: 21px;
            }
        }
    </style>
</head>

<body>

<div class="dashboard">

    <!-- Шапка -->
    <header class="header">
        <div>
            <h1>Посещаемость учебной группы</h1>
            <p>Аналитическая панель · Статистика посещения занятий</p>
        </div>

        <div class="status" id="status">
            <span class="status-dot"></span>
            <span id="statusText">Загрузка данных</span>
        </div>
    </header>

    <!-- Сообщения -->
    <div id="message" class="message loading">
        Загрузка данных из attendance.csv...
    </div>

    <!-- Основные показатели -->
    <section>
        <h2 class="section-title">Ключевые показатели</h2>

        <div class="metrics">

            <div class="metric-card">
                <div class="metric-label">
                    Средняя посещаемость группы
                </div>
                <div class="metric-value" id="averageAttendance">—</div>
                <div class="metric-description">
                    По всем проведённым занятиям
                </div>
            </div>

            <div class="metric-card">
                <div class="metric-label">
                    Количество студентов
                </div>
                <div class="metric-value" id="studentCount">—</div>
                <div class="metric-description">
                    По данным учебного списка
                </div>
            </div>

            <div class="metric-card">
                <div class="metric-label">
                    Количество занятий
                </div>
                <div class="metric-value" id="lessonCount">—</div>
                <div class="metric-description">
                    Всего дат в таблице
                </div>
            </div>

        </div>
    </section>

    <!-- Графики -->
    <section>
        <h2 class="section-title">Анализ посещаемости</h2>

        <div class="charts">

            <!-- Линейный график -->
            <div class="chart-card">

                <div class="chart-heading">
                    <div>
                        <h2>Динамика посещаемости</h2>
                        <p>Изменение посещаемости группы по датам</p>
                    </div>

                    <span class="chart-tag">
                        Линейный график
                    </span>
                </div>

                <div id="attendanceChart" class="chart"></div>

            </div>

            <!-- Столбчатая диаграмма -->
            <div class="chart-card">

                <div class="chart-heading">
                    <div>
                        <h2>Распределение студентов</h2>
                        <p>По доле посещённых занятий</p>
                    </div>

                    <span class="chart-tag">
                        Столбчатая диаграмма
                    </span>
                </div>

                <div id="distributionChart" class="chart"></div>

            </div>

        </div>
    </section>

    <!-- Источник данных -->
    <footer class="footer">
        Источник данных: учебная таблица посещаемости группы.
        Данные обезличены, вместо персональных данных используются
        коды студентов.

        <span class="updated" id="updated">
            Данные ещё не загружены
        </span>
    </footer>

</div>

<script>
    "use strict";

    // ==========================================
    // 1. НАСТРОЙКИ
    // ==========================================

    const CSV_FILE = "attendance.csv";

    let attendanceChart = null;
    let distributionChart = null;


    // ==========================================
    // 2. ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ
    // ==========================================

    function showMessage(type, message) {
        const element = document.getElementById("message");

        element.className = "message " + type;
        element.innerHTML = message;
    }


    function setStatus(text, success = true) {
        const status = document.getElementById("status");
        const statusText = document.getElementById("statusText");

        statusText.textContent = text;

        status.style.background = success ? "#eaf5f1" : "#fff0f0";
        status.style.color = success ? "#348b72" : "#a64444";

        status.querySelector(".status-dot").style.background =
            success ? "#35a889" : "#d87979";
    }


    function formatDate(date) {
        const parts = date.split("-");

        if (parts.length !== 3) {
            return date;
        }

        return parts[2] + "." + parts[1] + "." + parts[0];
    }


    function formatPercent(value) {
        return value.toFixed(1).replace(".", ",") + "%";
    }


    // ==========================================
    // 3. ЧТЕНИЕ ФАЙЛА И ОПРЕДЕЛЕНИЕ КОДИРОВКИ
    // ==========================================

    async function loadCSV() {

        const response = await fetch(CSV_FILE + "?t=" + Date.now(), {
            cache: "no-store"
        });

        if (!response.ok) {
            throw new Error(
                "Не удалось загрузить attendance.csv. " +
                "Код ответа сервера: " + response.status + ". " +
                "Проверьте наличие файла в корне репозитория."
            );
        }

        const buffer = await response.arrayBuffer();

        // Сначала пробуем UTF-8.
        try {
            const decoder = new TextDecoder("utf-8", {
                fatal: true
            });

            return decoder.decode(buffer).replace(/^\uFEFF/, "");

        } catch (error) {

            // Если UTF-8 не подходит, пробуем Windows-1251.
            try {
                const decoder = new TextDecoder("windows-1251");

                return decoder.decode(buffer).replace(/^\uFEFF/, "");

            } catch (encodingError) {
                throw new Error(
                    "Не удалось прочитать файл. " +
                    "Проверьте его кодировку."
                );
            }
        }
    }


    // ==========================================
    // 4. ОПРЕДЕЛЕНИЕ РАЗДЕЛИТЕЛЯ CSV
    // ==========================================

    function detectDelimiter(text) {

        const firstLine = text.split(/\r\n|\n|\r/, 1)[0];

        let commaCount = 0;
        let semicolonCount = 0;
        let inQuotes = false;

        for (let i = 0; i < firstLine.length; i++) {

            const char = firstLine[i];

            if (char === '"') {

                if (inQuotes && firstLine[i + 1] === '"') {
                    i++;
                } else {
                    inQuotes = !inQuotes;
                }

            } else if (!inQuotes) {

                if (char === ",") {
                    commaCount++;
                }

                if (char === ";") {
                    semicolonCount++;
                }
            }
        }

        if (commaCount === 0 && semicolonCount === 0) {
            throw new Error(
                "Не удалось определить разделитель CSV."
            );
        }

        return semicolonCount > commaCount ? ";" : ",";
    }


    // ==========================================
    // 5. ПОЛНОЦЕННЫЙ CSV-ПАРСЕР
    // ==========================================

    function parseCSV(text, delimiter) {

        const rows = [];

        let row = [];
        let field = "";
        let inQuotes = false;

        for (let i = 0; i < text.length; i++) {

            const char = text[i];

            // Обработка кавычек.
            if (char === '"') {

                if (inQuotes && text[i + 1] === '"') {

                    field += '"';
                    i++;

                } else {

                    inQuotes = !inQuotes;
                }

            } else if (char === delimiter && !inQuotes) {

                row.push(field);
                field = "";

            } else if (
                (char === "\n" || char === "\r") &&
                !inQuotes
            ) {

                row.push(field);
                field = "";

                if (row.some(cell => cell.trim() !== "")) {
                    rows.push(row);
                }

                row = [];

                if (char === "\r" && text[i + 1] === "\n") {
                    i++;
                }

            } else {

                field += char;
            }
        }

        if (inQuotes) {
            throw new Error(
                "Ошибка структуры CSV: обнаружена незакрытая кавычка."
            );
        }

        // Последняя строка файла.
        if (field !== "" || row.length > 0) {

            row.push(field);

            if (row.some(cell => cell.trim() !== "")) {
                rows.push(row);
            }
        }

        return rows;
    }


    // ==========================================
    // 6. ПРОВЕРКА И ОБРАБОТКА ДАННЫХ
    // ==========================================

    function processData(rows) {

        if (rows.length < 2) {
            throw new Error(
                "В CSV недостаточно данных. " +
                "Добавьте заголовок и строки студентов."
            );
        }

        const headers = rows[0].map(cell => cell.trim());

        if (headers[0].toLowerCase() !== "code") {
            throw new Error(
                "Первый столбец CSV должен называться code."
            );
        }

        const dates = headers.slice(1);

        if (dates.length === 0) {
            throw new Error(
                "В CSV отсутствуют даты занятий."
            );
        }

        // Проверяем формат дат.
        const datePattern = /^\d{4}-\d{2}-\d{2}$/;

        dates.forEach(date => {

            if (!datePattern.test(date)) {
                throw new Error(
                    "Некорректный формат даты: " + date +
                    ". Используйте ГГГГ-ММ-ДД."
                );
            }

            const parsed = new Date(date + "T00:00:00Z");

            if (
                Number.isNaN(parsed.getTime()) ||
                parsed.toISOString().slice(0, 10) !== date
            ) {
                throw new Error(
                    "Несуществующая дата занятия: " + date
                );
            }
        });

        if (new Set(dates).size !== dates.length) {
            throw new Error(
                "В таблице обнаружены повторяющиеся даты."
            );
        }

        const students = [];
        const studentCodes = new Set();

        for (let i = 1; i < rows.length; i++) {

            const currentRow = rows[i];

            if (currentRow.length > headers.length) {
                throw new Error(
                    "В строке " + (i + 1) +
                    " обнаружено больше столбцов, чем в заголовке."
                );
            }

            // Заполняем недостающие ячейки пустыми значениями.
            while (currentRow.length < headers.length) {
                currentRow.push("");
            }

            const code = currentRow[0].trim();

            if (!code) {
                throw new Error(
                    "В строке " + (i + 1) +
                    " отсутствует код студента."
                );
            }

            if (studentCodes.has(code)) {
                throw new Error(
                    "Обнаружен повторяющийся код студента: " + code
                );
            }

            studentCodes.add(code);

            const attendance = currentRow.slice(1).map(
                value => value.trim()
            );

            // Проверяем значения: 0, 1 или пустая ячейка.
            attendance.forEach((value, index) => {

                if (
                    value !== "" &&
                    value !== "0" &&
                    value !== "1"
                ) {
                    throw new Error(
                        "Некорректное значение в строке " +
                        (i + 1) +
                        ", дата " + dates[index] +
                        ". Допустимы только 0, 1 или пустая ячейка."
                    );
                }
            });

            students.push({
                code: code,
                attendance: attendance
            });
        }

        if (students.length === 0) {
            throw new Error(
                "В таблице отсутствуют студенты."
            );
        }

        // Подсчёт посещаемости каждого занятия.
        const lessonStats = dates.map((date, index) => {

            let present = 0;
            let observed = 0;

            students.forEach(student => {

                const value = student.attendance[index];

                // Пустые ячейки не учитываем.
                if (value === "") {
                    return;
                }

                observed++;

                if (value === "1") {
                    present++;
                }
            });

            const percentage = observed > 0
                ? (present / observed) * 100
                : null;

            return {
                date: date,
                present: present,
                observed: observed,
                percentage: percentage
            };
        });

        // Средняя посещаемость по всем занятиям.
        // Рассчитывается как среднее арифметическое
        // процентов посещаемости отдельных занятий.
        const validLessons = lessonStats.filter(
            lesson => lesson.percentage !== null
        );

        const averageAttendance = validLessons.length > 0
            ? validLessons.reduce(
                (sum, lesson) => sum + lesson.percentage, 0
            ) / validLessons.length
            : 0;

        // Доля посещённых занятий для каждого студента.
        const studentStats = students.map(student => {

            let present = 0;
            let observed = 0;

            student.attendance.forEach(value => {

                if (value === "") {
                    return;
                }

                observed++;

                if (value === "1") {
                    present++;
                }
            });

            const percentage = observed > 0
                ? (present / observed) * 100
                : null;

            return {
                code: student.code,
                present: present,
                observed: observed,
                percentage: percentage
            };
        });

        // Распределение студентов по категориям.
        const categories = [
            {
                name: "Менее 25%",
                min: 0,
                max: 25,
                count: 0
            },
            {
                name: "25–50%",
                min: 25,
                max: 50,
                count: 0
            },
            {
                name: "50–75%",
                min: 50,
                max: 75,
                count: 0
            },
            {
                name: "75% и более",
                min: 75,
                max: 100,
                count: 0
            }
        ];

        studentStats.forEach(student => {

            // Студенты без данных не включаются
            // в распределение по посещаемости.
            if (student.percentage === null) {
                return;
            }

            const value = student.percentage;

            if (value < 25) {
                categories[0].count++;

            } else if (value < 50) {
                categories[1].count++;

            } else if (value < 75) {
                categories[2].count++;

            } else {
                categories[3].count++;
            }
        });

        return {
            dates,
            students,
            lessonStats,
            studentStats,
            categories,
            averageAttendance,
            studentCount: students.length,
            lessonCount: dates.length,
            studentsWithoutData: studentStats.filter(
                student => student.percentage === null
            ).length
        };
    }


    // ==========================================
    // 7. ОТОБРАЖЕНИЕ ОСНОВНЫХ ПОКАЗАТЕЛЕЙ
    // ==========================================

    function renderMetrics(data) {

        document.getElementById("averageAttendance").textContent =
            formatPercent(data.averageAttendance);

        document.getElementById("studentCount").textContent =
            data.studentCount;

        document.getElementById("lessonCount").textContent =
            data.lessonCount;

    }


    // ==========================================
    // 8. ЛИНЕЙНЫЙ ГРАФИК
    // ==========================================

    function renderAttendanceChart(data) {

        const element = document.getElementById("attendanceChart");

        if (attendanceChart) {
            attendanceChart.dispose();
        }

        attendanceChart = echarts.init(element);

        const dates = data.dates.map(formatDate);

        const values = data.lessonStats.map(
            lesson => lesson.percentage === null
                ? null
                : Number(lesson.percentage.toFixed(2))
        );

        const averageLine = data.dates.map(
            () => Number(data.averageAttendance.toFixed(2))
        );

        const option = {

            animation: true,

            color: ["#526fba", "#e6a35c"],

            tooltip: {
                trigger: "axis",
                backgroundColor: "#ffffff",
                borderColor: "#e9edf2",
                borderWidth: 1,
                textStyle: {
                    color: "#202b3c",
                    fontSize: 12
                },

                formatter: function(params) {

                    const index = params[0].dataIndex;
                    const lesson = data.lessonStats[index];

                    let result =
                        "<b>" + dates[index] + "</b><br/>";

                    if (lesson.percentage === null) {

                        result +=
                            "Нет данных о посещаемости";

                    } else {

                        result +=
                            "Присутствовало: <b>" +
                            lesson.present + "</b><br/>" +

                            "Учитывается студентов: <b>" +
                            lesson.observed + "</b><br/>" +

                            "Посещаемость: <b>" +
                            formatPercent(lesson.percentage) +
                            "</b>";
                    }

                    result +=
                        "<br/>Среднее группы: <b>" +
                        formatPercent(data.averageAttendance) +
                        "</b>";

                    return result;
                }
            },

            legend: {
                bottom: 0,
                textStyle: {
                    color: "#8290a3",
                    fontSize: 11
                },
                data: [
                    "Посещаемость группы",
                    "Средняя посещаемость"
                ]
            },

            grid: {
                left: "3%",
                right: "4%",
                top: "12%",
                bottom: "18%",
                containLabel: true
            },

            xAxis: {
                type: "category",
                boundaryGap: false,
                data: dates,

                axisLine: {
                    lineStyle: {
                        color: "#e9edf2"
                    }
                },

                axisTick: {
                    show: false
                },

                axisLabel: {
                    color: "#8290a3",
                    fontSize: 10,
                    rotate: 35,
                    interval: 0
                }
            },

            yAxis: {
                type: "value",
                min: 0,
                max: 100,
                interval: 25,

                axisLabel: {
                    formatter: "{value}%",
                    color: "#8290a3",
                    fontSize: 11
                },

                splitLine: {
                    lineStyle: {
                        color: "#f0f2f5",
                        type: "dashed"
                    }
                }
            },

            series: [

                {
                    name: "Посещаемость группы",
                    type: "line",
                    data: values,

                    smooth: 0.3,

                    connectNulls: false,

                    symbol: "circle",
                    symbolSize: 8,

                    lineStyle: {
                        width: 3,
                        color: "#526fba"
                    },

                    itemStyle: {
                        color: "#526fba",
                        borderColor: "#ffffff",
                        borderWidth: 2
                    },

                    areaStyle: {
                        color: "rgba(82, 111, 186, 0.10)"
                    }
                },

                {
                    name: "Средняя посещаемость",
                    type: "line",
                    data: averageLine,

                    symbol: "none",

                    lineStyle: {
                        color: "#e6a35c",
                        width: 2,
                        type: "dashed"
                    },

                    itemStyle: {
                        color: "#e6a35c"
                    }
                }
            ]
        };

        attendanceChart.setOption(option);
    }


    // ==========================================
    // 9. СТОЛБЧАТАЯ ДИАГРАММА
    // ==========================================

    function renderDistributionChart(data) {

        const element = document.getElementById("distributionChart");

        if (distributionChart) {
            distributionChart.dispose();
        }

        distributionChart = echarts.init(element);

        const categories = data.categories;

        const option = {

            animation: true,

            color: ["#526fba"],

            tooltip: {

                trigger: "axis",
                axisPointer: {
                    type: "shadow"
                },

                backgroundColor: "#ffffff",
                borderColor: "#e9edf2",
                borderWidth: 1,

                textStyle: {
                    color: "#202b3c",
                    fontSize: 12
                },

                formatter: function(params) {

                    const item = categories[params[0].dataIndex];

                    return (
                        "<b>" + item.name + "</b><br/>" +
                        "Количество студентов: <b>" +
                        item.count + "</b>"
                    );
                }
            },

            grid: {
                left: "5%",
                right: "7%",
                top: "12%",
                bottom: "18%",
                containLabel: true
            },

            xAxis: {

                type: "category",

                data: categories.map(item => item.name),

                axisTick: {
                    show: false
                },

                axisLine: {
                    lineStyle: {
                        color: "#e9edf2"
                    }
                },

                axisLabel: {
                    color: "#8290a3",
                    fontSize: 10,
                    interval: 0
                }
            },

            yAxis: {

                type: "value",

                minInterval: 1,

                axisLabel: {
                    color: "#8290a3",
                    fontSize: 11
                },

                splitLine: {
                    lineStyle: {
                        color: "#f0f2f5",
                        type: "dashed"
                    }
                }
            },

            series: [

                {
                    name: "Количество студентов",
                    type: "bar",

                    data: categories.map(item => item.count),

                    barWidth: "43%",

                    itemStyle: {

                        borderRadius: [6, 6, 0, 0],

                        color: function(params) {

                            const colors = [
                                "#d87979",
                                "#e6a35c",
                                "#7795c8",
                                "#35a889"
                            ];

                            return colors[params.dataIndex];
                        }
                    },

                    label: {
                        show: true,
                        position: "top",
                        color: "#526174",
                        fontWeight: 600,
                        fontSize: 12
                    }
                }
            ]
        };

        distributionChart.setOption(option);
    }


    // ==========================================
    // 10. ЗАПУСК АНАЛИТИКИ
    // ==========================================

    async function initializeDashboard() {

        try {

            showMessage(
                "loading",
                "Загружаем и обрабатываем attendance.csv..."
            );

            setStatus("Загрузка данных", false);

            // Получаем полный CSV.
            const csvText = await loadCSV();

            // Определяем разделитель.
            const delimiter = detectDelimiter(csvText);

            // Разбираем содержимое CSV.
            const rows = parseCSV(csvText, delimiter);

            // Рассчитываем показатели.
            const data = processData(rows);

            // Обновляем карточки.
            renderMetrics(data);

            // Строим графики.
            renderAttendanceChart(data);
            renderDistributionChart(data);

            // Информация о времени обновления.
            const now = new Date();

            document.getElementById("updated").textContent =
                "Последнее обновление: " +
                now.toLocaleString("ru-RU");

            // Сообщение о пропущенных строках.
            let successMessage =
                "Данные успешно загружены. " +
                "Обработано студентов: " +
                data.studentCount + ". " +
                "Занятий: " + data.lessonCount + ".";

            if (data.studentsWithoutData > 0) {
                successMessage +=
                    " Студентов без данных о посещаемости: " +
                    data.studentsWithoutData + ".";
            }

            showMessage("success", successMessage);

            setStatus("Данные загружены", true);

        } catch (error) {

            console.error("Ошибка аналитики:", error);

            // Сбрасываем графики при ошибке.
            if (attendanceChart) {
                attendanceChart.dispose();
                attendanceChart = null;
            }

            if (distributionChart) {
                distributionChart.dispose();
                distributionChart = null;
            }

            document.getElementById("averageAttendance").textContent = "—";
            document.getElementById("studentCount").textContent = "—";
            document.getElementById("lessonCount").textContent = "—";

            showMessage(
                "error",
                "<b>Не удалось загрузить данные.</b><br/>" +
                error.message +
                "<br/><button class='retry-button' " +
                "onclick='initializeDashboard()'>" +
                "Повторить загрузку</button>"
            );

            setStatus("Ошибка загрузки", false);
        }
    }


    // ==========================================
    // 11. АДАПТАЦИЯ ГРАФИКОВ ПРИ ИЗМЕНЕНИИ РАЗМЕРА
    // ==========================================

    let resizeTimer = null;

    window.addEventListener("resize", function() {

        clearTimeout(resizeTimer);

        resizeTimer = setTimeout(function() {

            if (attendanceChart) {
                attendanceChart.resize();
            }

            if (distributionChart) {
                distributionChart.resize();
            }

        }, 150);
    });


    // ==========================================
    // 12. АВТОМАТИЧЕСКИЙ ЗАПУСК
    // ==========================================

    initializeDashboard();

</script>

